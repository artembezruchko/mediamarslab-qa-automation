# Copy to .env and fill in real values. Never commit .env.
BASE_URL=https://qa-a.recruitment.mediamarslab.com
API_BASE_URL=https://qa-a.recruitment.mediamarslab.com

# Access key issued once by POST /api/applications, format: <id>.<secret>
X_ACCESS_KEY=<id>.<secret>

# Admin credentials issued once by POST /api/applications
ADMIN_EMAIL=admin+<id>@vacancy.local
ADMIN_PASSWORD=<admin-password>

# Basic auth for GET /api/analytics/events (used together with X-Access-Key)
ANALYTICS_BASIC_USER=QA_USER
ANALYTICS_BASIC_PASSWORD=<analytics-basic-password>
