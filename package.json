{
  "name": "qa-automation-mediamarslab",
  "version": "1.0.0",
  "description": "Playwright + TypeScript E2E/API test automation suite for the mediamarslab recruitment QA app",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:resilient": "node scripts/test-with-retry.js",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium-ui",
    "test:auth": "playwright test --project=auth-ui",
    "test:admin": "playwright test --project=admin",
    "test:e2e": "playwright test --project=e2e",
    "test:headed": "playwright test --headed",
    "test:ui-mode": "playwright test --ui",
    "report": "playwright show-report",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.0"
  }
}
